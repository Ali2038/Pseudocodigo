Algoritmo "numero_Primo"

Var numero:inteiro



Inicio
escreva ("Digite o número: ")
leia (numero)

se (numero >= 2) e (numero / numero = 1) e (numero % 2 <> 0)   entao
escreva ("primo")
senao

se (numero=2) entao
escreva ("primo")
senao

escreva ("Não é primo")
fimse
fimse
Fimalgoritmo